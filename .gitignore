# Environment variables (contains secrets)
.env

# Persisted runtime state (comment mappings) — written to data/ when running locally
data/

# Node modules
node_modules/
dist/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Secrets and per-mapping databases, wherever they are written (CLAUDE.md invariant 6)
master.key
*.sqlite
*.sqlite-wal
*.sqlite-shm
